    function openPageReviewLightbox(pageNum){
      var pr = PAGE_REVIEWS[pageNum]; if(!pr) return;
      var html = '';
      if(pr.simpleWay){
        html += '<div style="padding:14px 16px; border-radius:12px; background:var(--turquoise-bg); border:1px solid rgba(13,148,136,0.3); margin-bottom:16px;">' +
          '<div style="font-weight:800; color:var(--turquoise); margin-bottom:6px; font-size:0.95rem;">أبسط طريقة تفهم بيها زبدة الصفحة:</div>' +
          '<div style="font-weight:600; color:var(--text-primary); line-height:1.75;">'+renderMarked(pr.simpleWay)+'</div></div>';
      }
      html += '<div style="padding:16px; border-radius:12px; background:var(--bg-canvas); border:1px solid var(--border-hairline); margin-bottom:16px;">' +
        '<div style="font-weight:800; color:var(--navy); margin-bottom:10px;">الخلاصة الكاملة للصفحة '+pageNum+':</div><ul style="padding-right:18px; display:flex; flex-direction:column; gap:8px;">';
      (pr.takeaways || []).forEach(function(item){ html += '<li>'+renderMarked(item)+'</li>'; });
      html += '</ul></div>';
      html += '<div style="padding:16px; border-radius:12px; background:var(--gold-bg); border:1px solid rgba(180,138,62,0.30);">' +
        '<div style="font-weight:800; color:var(--gold); margin-bottom:8px;">مصائد الامتحان السريرية في هذه الصفحة:</div><ul style="padding-right:18px; display:flex; flex-direction:column; gap:6px;">';
      (pr.traps || []).forEach(function(tr){ html += '<li>'+renderMarked(tr)+'</li>'; });
      html += '</ul></div>';
      openLightbox(pr.title, html);
    }

    /* Interactive Quiz Renderer */
    var LEVEL_AR = { easy: "سهل", medium: "متوسط", hard: "صعب", precise: "دقيق جداً", application: "تطبيقي", clinical: "سؤال سريري" };

    function renderQuizCardsInto(mountEl, questions, titleContext){
      if(!questions.length){
        mountEl.innerHTML = '<div style="padding:20px; text-align:center; color:var(--text-muted);">لا توجد أسئلة مطابقة للتصفية الحالية.</div>';
        return;
      }
      var scoreBox = document.createElement("div");
      scoreBox.style.cssText = "padding:12px 16px; border-radius:10px; background:var(--turquoise-bg); border:1px solid rgba(13,148,136,0.25); margin-bottom:16px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px;";
      mountEl.innerHTML = "";
      mountEl.appendChild(scoreBox);

      function updateScore(){
        var ans = 0, cor = 0;
        questions.forEach(function(q){
          var r = state.answeredMcqs[q.id];
          if(r){ ans++; if(r.correct) cor++; }
        });
        scoreBox.innerHTML = '<div style="font-weight:800; color:var(--navy);">نتيجتك في '+esc(titleContext)+': <span class="tabular-nums" style="color:var(--turquoise);">'+cor+' / '+questions.length+'</span> (المُجاب: '+ans+')</div>' +
          '<button type="button" class="btn-secondary" data-reset-quiz style="padding:6px 12px; font-size:0.8rem;">إعادة اختبار هذه المجموعة</button>';
        scoreBox.querySelector("[data-reset-quiz]").addEventListener("click", function(){
          questions.forEach(function(q){ delete state.answeredMcqs[q.id]; });
          saveState(); renderQuizCardsInto(mountEl, questions, titleContext);
        });
      }

      questions.forEach(function(q, idx){
        var card = document.createElement("div");
        card.className = "mcq-card";
        var prev = state.answeredMcqs[q.id];
        var html = '<div class="mcq-meta">سؤال '+(idx+1)+' من '+questions.length+' · صفحة '+q.page+' · المستوى: '+(LEVEL_AR[q.level] || q.level)+'</div>' +
          '<div class="mcq-question-en">'+esc(q.qEn)+'</div>' +
          '<div class="mcq-question-iq">'+esc(q.qIq)+'</div><div class="mcq-options">';
        q.options.forEach(function(opt, oi){
          var cls = "mcq-option-btn";
          if(prev){
            if(oi === q.correctIndex) cls += " correct";
            else if(oi === prev.selected) cls += " wrong";
          }
          html += '<button type="button" class="'+cls+'" data-oi="'+oi+'" '+(prev ? "disabled" : "")+'>' +
            '<span class="mcq-opt-en">'+String.fromCharCode(65+oi)+'. '+esc(opt)+'</span>' +
            '<span class="mcq-opt-iq">'+esc(q.optionsIq[oi])+'</span></button>';
        });
        html += '</div><div class="mcq-explanation '+(prev ? "" : "hidden")+'">'+(prev ? buildExpHtml(q, prev.selected) : "")+'</div>';
        card.innerHTML = html;
        mountEl.appendChild(card);

        card.querySelectorAll(".mcq-option-btn").forEach(function(btn){
          btn.addEventListener("click", function(){
            var chosen = Number(btn.getAttribute("data-oi"));
            var ok = chosen === q.correctIndex;
            state.answeredMcqs[q.id] = { selected: chosen, correct: ok, ts: Date.now() };
            state.testHistory.push({ id: q.id, page: q.page, topicId: q.topicId, correct: ok, ts: Date.now() });
            if(state.testHistory.length > 300) state.testHistory.shift();
            saveState();

            card.querySelectorAll(".mcq-option-btn").forEach(function(b2, bIdx){
              b2.disabled = true;
              if(bIdx === q.correctIndex) b2.classList.add("correct");
              else if(bIdx === chosen && !ok) b2.classList.add("wrong");
            });
            var exp = card.querySelector(".mcq-explanation");
            exp.innerHTML = buildExpHtml(q, chosen);
            exp.classList.remove("hidden");
            updateScore();
          });
        });
      });
      updateScore();
    }

    function buildExpHtml(q, chosen){
      var ok = chosen === q.correctIndex;
      var h = '<div style="font-weight:800; color:'+(ok?"#059669":"#DC2626")+'; margin-bottom:6px;">'+(ok ? "إجابة صحيحة! أحسنت يا دكتور" : "إجابة خاطئة — الإجابة الصحيحة هي الاختيار "+String.fromCharCode(65+q.correctIndex))+'</div>' +
        '<div style="margin-bottom:8px;"><strong>ليش هي الصح؟</strong> '+esc(q.whyCorrectIq)+'</div>';
      if(q.whyWrongIq && q.whyWrongIq.length){
        h += '<div style="font-size:0.84rem; color:var(--text-secondary);"><strong>تحليل بقية الخيارات:</strong><ul style="padding-right:18px; margin-top:4px;">';
        q.whyWrongIq.forEach(function(w, i){
          h += '<li><strong>'+String.fromCharCode(65+i)+':</strong> '+esc(w)+'</li>';
        });
        h += '</ul></div>';
      }
      return h;
    }

    function openTopicQuizLightbox(topicId){
      var res = findTopic(topicId); if(!res) return;
      var qs = QBANK.filter(function(q){ return q.topicId === topicId; });
      openLightbox("اختبار الموضوع: " + res.topic.titleAr, '<div id="lbQuizHost"></div>');
      renderQuizCardsInto(document.getElementById("lbQuizHost"), qs, res.topic.titleAr);
    }

    function openPageQuizLightbox(pageNum){
      var qs = QBANK.filter(function(q){ return q.page === pageNum; });
      openLightbox("جميع أسئلة الصفحة " + pageNum, '<div id="lbPageQuizHost"></div>');
      renderQuizCardsInto(document.getElementById("lbPageQuizHost"), qs, "الصفحة " + pageNum);
    }

    /* Render Lecture Page */
    function goToPage(pageNum){
      if(pageNum < 1) pageNum = 1;
      if(pageNum > PAGES.length) pageNum = PAGES.length;
      state.currentPage = pageNum;
      saveState();
      renderLecturePage(pageNum);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderLecturePage(pageNum){
      if(window.VisualSimEngine) window.VisualSimEngine.cleanupAll();
      var pageObj = PAGES.find(function(p){ return p.pageNumber === pageNum; }) || PAGES[0];
      if(!pageObj) return;

      var pills = document.getElementById("pagePillsContainer");
      pills.innerHTML = PAGES.map(function(p){
        var cls = "page-step-btn";
        if(p.pageNumber === pageObj.pageNumber) cls += " active";
        else if(state.completedPages.indexOf(p.pageNumber) !== -1) cls += " completed";
        return '<button class="'+cls+'" data-nav-page="'+p.pageNumber+'">صفحة '+p.pageNumber+'</button>';
      }).join("");
      pills.querySelectorAll("[data-nav-page]").forEach(function(b){
        b.addEventListener("click", function(){ goToPage(Number(b.getAttribute("data-nav-page"))); });
      });

      document.getElementById("prevPageBtn").disabled = pageObj.pageNumber <= 1;
      document.getElementById("nextPageBtn").disabled = pageObj.pageNumber >= PAGES.length;

      var isPageDone = state.completedPages.indexOf(pageObj.pageNumber) !== -1;
      var html = '<div class="page-banner">' +
        '<div class="page-kicker">'+esc(pageObj.subtitle)+'</div>' +
        '<h2 class="page-title-ar">'+esc(pageObj.titleAr)+'</h2>' +
        '<div class="page-title-en">'+esc(pageObj.titleEn)+'</div>' +
        '<div class="page-toolbar">' +
        '<div style="font-size:0.85rem; color:var(--text-muted); font-weight:700;">مواضيع هذه الصفحة: '+pageObj.topics.length+' مواضيع مستقلة</div>' +
        '<button id="togglePageCompleteBtn" class="action-chip-btn '+(isPageDone?"active":"")+'">'+(isPageDone ? "الصفحة مكتملة" : "تحديد الصفحة كمكتملة")+'</button>' +
        '</div></div>';

      pageObj.topics.forEach(function(t){
        var isTopicDone = state.completedTopics.indexOf(t.id) !== -1;
        var isBook = state.bookmarkedTopics.indexOf(t.id) !== -1;
        html += '<article class="topic-section" id="topic-'+esc(t.id)+'">' +
          '<div class="topic-header"><div>' +
          '<div class="topic-index">'+esc(t.indexLabel)+'</div>' +
          '<h3 class="topic-title-en">'+esc(t.titleEn)+'</h3>' +
          '<div class="topic-title-ar">'+esc(t.titleAr)+'</div>' +
          '</div><div class="topic-actions-inline">' +
          '<button class="action-chip-btn '+(isTopicDone?"active":"")+'" data-toggle-topic="'+esc(t.id)+'">'+(isTopicDone?"مكتمل":"تحديد كمكتمل")+'</button>' +
          '<button class="action-chip-btn '+(isBook?"bookmarked":"")+'" data-toggle-book="'+esc(t.id)+'">'+(isBook?"محفوظ للمراجعة":"حفظ للمراجعة")+'</button>' +
          '</div></div>';

        t.segments.forEach(function(seg){
          html += '<div class="segment-pair">' +
            '<div class="en-block">'+seg.enHtml+'</div>' +
            '<div class="iq-block">'+seg.iqHtml+'</div>' +
          '</div>';
        });

        if(t.helperNote){
          html += '<div class="helper-note"><div class="helper-note-title">ملاحظة سريرية مركزة من نفس الصفحة:</div><div>'+renderMarked(t.helperNote)+'</div></div>';
        }

        html += '<div class="visual-section">' +
          '<div class="visual-header">' +
          '<div class="visual-title"><span>تذكرها بصرياً</span></div>' +
          '<div class="visual-mode-meta">'+esc(t.simTitle)+'</div>' +
          '</div>' +
          '<div class="visual-stage paper-canvas dark-capable" id="vis-'+esc(t.id)+'"></div>' +
        '</div>';

        html += '<div class="topic-divider"></div>' +
          '<div class="topic-gate-actions">' +
          '<button type="button" class="gate-btn" data-open-topic-rev="'+esc(t.id)+'"><span>مراجعة هذا الموضوع</span><span>&#8592;</span></button>' +
          '<button type="button" class="gate-btn quiz-gate" data-open-topic-quiz="'+esc(t.id)+'"><span>اختبر نفسك في هذا الموضوع</span><span>&#8592;</span></button>' +
          '</div></article>';
      });

      html += '<div class="page-end-divider"><span>نهاية الصفحة '+pageObj.pageNumber+' من '+PAGES.length+'</span></div>' +
        '<div class="page-gate-grid">' +
        '<button type="button" class="page-gate-card" id="openPageRevGateBtn"><div><div style="font-weight:800; color:var(--navy); font-size:1.05rem;">مراجعة سريعة للصفحة '+pageObj.pageNumber+'</div><div style="font-size:0.84rem; color:var(--text-muted);">خلاصة النقاط الذهبية ومصائد الامتحان</div></div><span style="font-size:1.25rem; color:var(--turquoise);">&#8592;</span></button>' +
        '<button type="button" class="page-gate-card" id="openPageQuizGateBtn"><div><div style="font-weight:800; color:var(--navy); font-size:1.05rem;">جميع الأسئلة التي تخص هذه الصفحة</div><div style="font-size:0.84rem; color:var(--text-muted);">اختبار شامل لكل مواضيع الصفحة '+pageObj.pageNumber+'</div></div><span style="font-size:1.25rem; color:var(--gold);">&#8592;</span></button>' +
        '</div>';

      var mount = document.getElementById("lecturePageMount");
      mount.innerHTML = html;

      if(window.VisualSimEngine){
        pageObj.topics.forEach(function(t){ window.VisualSimEngine.mountTopicVisual(t); });
      }

      document.getElementById("togglePageCompleteBtn").addEventListener("click", function(){
        var idx = state.completedPages.indexOf(pageObj.pageNumber);
        if(idx === -1){
          state.completedPages.push(pageObj.pageNumber);
          pageObj.topics.forEach(function(t){ if(state.completedTopics.indexOf(t.id)===-1) state.completedTopics.push(t.id); });
          showToast("تم تسجيل الصفحة " + pageObj.pageNumber + " كمكتملة");
        } else {
          state.completedPages.splice(idx, 1);
          showToast("تم إلغاء إكمال الصفحة " + pageObj.pageNumber);
        }
        saveState(); renderLecturePage(pageObj.pageNumber);
      });

      mount.querySelectorAll("[data-toggle-topic]").forEach(function(b){
        b.addEventListener("click", function(){
          var tid = b.getAttribute("data-toggle-topic");
          var idx = state.completedTopics.indexOf(tid);
          if(idx === -1){ state.completedTopics.push(tid); showToast("تم حفظ إكمال الموضوع"); }
          else { state.completedTopics.splice(idx, 1); }
          saveState(); renderLecturePage(pageObj.pageNumber);
        });
      });

      mount.querySelectorAll("[data-toggle-book]").forEach(function(b){
        b.addEventListener("click", function(){
          var tid = b.getAttribute("data-toggle-book");
          var idx = state.bookmarkedTopics.indexOf(tid);
          if(idx === -1){ state.bookmarkedTopics.push(tid); showToast("تم حفظ الموضوع للمراجعة"); }
          else { state.bookmarkedTopics.splice(idx, 1); }
          saveState(); renderLecturePage(pageObj.pageNumber);
        });
      });

      mount.querySelectorAll("[data-open-topic-rev]").forEach(function(b){
        b.addEventListener("click", function(){ openTopicReviewLightbox(b.getAttribute("data-open-topic-rev")); });
      });
      mount.querySelectorAll("[data-open-topic-quiz]").forEach(function(b){
        b.addEventListener("click", function(){ openTopicQuizLightbox(b.getAttribute("data-open-topic-quiz")); });
      });
      document.getElementById("openPageRevGateBtn").addEventListener("click", function(){ openPageReviewLightbox(pageObj.pageNumber); });
      document.getElementById("openPageQuizGateBtn").addEventListener("click", function(){ openPageQuizLightbox(pageObj.pageNumber); });

      mount.querySelectorAll(".segment-pair").forEach(function(pairBox){
        var setPairState = function(pid, active){
          if(!pid) return;
          pairBox.querySelectorAll('mark[data-pair="'+pid+'"]').forEach(function(el){
            el.classList.toggle("hl-pair-active", active);
          });
        };
        pairBox.querySelectorAll("mark[data-pair]").forEach(function(mk){
          var pid = mk.getAttribute("data-pair");
          mk.addEventListener("mouseenter", function(){ setPairState(pid, true); });
          mk.addEventListener("mouseleave", function(){ setPairState(pid, false); });
          mk.addEventListener("click", function(){
            var on = !mk.classList.contains("hl-pair-active");
            pairBox.querySelectorAll("mark.hl-pair-active").forEach(function(x){ x.classList.remove("hl-pair-active"); });
            setPairState(pid, on);
          });
        });
      });
    }

    /* Focused Review View */
    function renderFocusedReviewView(){
      var host = document.getElementById("viewReview");
      var scope = host.getAttribute("data-scope") || "all";
      var selPage = Number(host.getAttribute("data-page") || 1);

      var items = [];
      PAGES.forEach(function(p){
        p.topics.forEach(function(t){
          var isHard = state.reviewHardTopics.indexOf(t.id) !== -1;
          var isBook = state.bookmarkedTopics.indexOf(t.id) !== -1;
          if(scope === "all") items.push({ page: p.pageNumber, topic: t });
          else if(scope === "page" && p.pageNumber === selPage) items.push({ page: p.pageNumber, topic: t });
          else if(scope === "hard" && (isHard || isBook)) items.push({ page: p.pageNumber, topic: t });
        });
      });

      var h = '<div class="workspace-panel">' +
        '<h2 style="font-size:1.5rem; font-weight:800; color:var(--navy); margin-bottom:6px;">المراجعة المركزة الذكية</h2>' +
        '<p style="color:var(--text-secondary); margin-bottom:16px;">راجع المادة كاملة أو صفحة محددة أو المواضيع المحفوظة والصعبة بنظام الاستدعاء النشط والتكرار</p>' +
        '<div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:20px;">' +
        '<button class="sim-btn '+(scope==="all"?"active":"")+'" data-rscope="all">كل المحاضرة ('+PAGES.reduce(function(a,p){return a+p.topics.length;},0)+' موضوع)</button>' +
        '<button class="sim-btn '+(scope==="page"?"active":"")+'" data-rscope="page">صفحة محددة</button>' +
        '<button class="sim-btn '+(scope==="hard"?"active":"")+'" data-rscope="hard">المحفوظة والصعبة ('+ (state.reviewHardTopics.length + state.bookmarkedTopics.length) +')</button>' +
        (scope==="page" ? '<select class="select-input" style="max-width:170px;" id="revPageSelect">'+PAGES.map(function(p){ return '<option value="'+p.pageNumber+'" '+(p.pageNumber===selPage?'selected':'')+'>صفحة '+p.pageNumber+'</option>'; }).join("")+'</select>' : '') +
        '</div>';

      if(scope === "all" || scope === "page"){
        var prPages = scope === "page" ? PAGES.filter(function(p){ return p.pageNumber === selPage; }) : PAGES;
        h += '<div style="margin-bottom:22px;">' +
          '<div style="font-weight:800; color:var(--turquoise); margin-bottom:10px; font-size:0.95rem;">كبسولات الصفحات السريعة (زبدة كل صفحة بأسلوب العيادة):</div>' +
          '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:10px;">';
        prPages.forEach(function(p){
          var pr = PAGE_REVIEWS[p.pageNumber];
          if(!pr) return;
          h += '<div style="padding:13px 15px; border-radius:12px; background:var(--turquoise-bg); border:1px solid rgba(13,148,136,0.28); display:flex; flex-direction:column; justify-content:space-between; gap:8px;">' +
            '<div><div style="font-weight:800; color:var(--navy); font-size:0.88rem; margin-bottom:4px;">'+esc(pr.title)+'</div>' +
            '<div style="font-size:0.84rem; color:var(--text-primary); line-height:1.68;">'+renderMarked(pr.simpleWay || (pr.takeaways && pr.takeaways[0]) || "")+'</div></div>' +
            '<div style="display:flex; justify-content:flex-end;"><button type="button" class="btn-secondary" data-rev-page-lb="'+p.pageNumber+'" style="padding:5px 11px; font-size:0.78rem;">مصائد وملخص الصفحة '+p.pageNumber+'</button></div>' +
          '</div>';
        });
        h += '</div></div>';
      }

      if(!items.length){
        h += '<div style="padding:24px; text-align:center; background:var(--bg-canvas); border-radius:12px; color:var(--text-muted);">لا توجد مواضيع محددة في هذه القائمة بعد — يمكنك حفظ أي موضوع من داخل المحاضرة أو نافذة المراجعة</div>';
      } else {
        items.forEach(function(it){
          var t = it.topic, done = state.reviewCompletedTopics.indexOf(t.id) !== -1;
          var swHtml = (t.review && t.review.simpleWay)
            ? '<div style="padding:11px 14px; border-radius:10px; background:var(--gold-bg); border:1px solid rgba(180,138,62,0.3); margin-bottom:10px; font-size:0.92rem; line-height:1.7;"><strong style="color:var(--gold);">أبسط طريقة تفهمها:</strong> '+renderMarked(t.review.simpleWay)+'</div>'
            : '';
          h += '<div style="padding:18px; border-radius:14px; background:var(--bg-canvas); border:1px solid var(--border-hairline); margin-bottom:14px;">' +
            '<div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; align-items:center; margin-bottom:10px;">' +
            '<div><span style="font-size:0.78rem; color:var(--turquoise); font-weight:800;">صفحة '+it.page+'</span><div class="ltr" style="font-weight:800; color:var(--navy);">'+esc(t.titleEn)+'</div><div style="font-weight:700; color:var(--text-secondary);">'+esc(t.titleAr)+'</div></div>' +
            '<div style="display:flex; gap:8px;"><button class="btn-secondary" data-rev-lb="'+esc(t.id)+'" style="padding:8px 14px; font-size:0.84rem;">'+(done?"مكتملة — فتح المراجعة":"فتح بطاقات المراجعة")+'</button>' +
            '<button class="btn-secondary" data-rev-quiz="'+esc(t.id)+'" style="padding:8px 14px; font-size:0.84rem;">اختبر نفسك</button></div>' +
            '</div>' + swHtml + '<ul style="padding-right:18px; font-size:0.9rem; color:var(--text-primary); display:flex; flex-direction:column; gap:5px;">' +
            (t.review && t.review.focusPoints ? t.review.focusPoints.map(function(pt){ return '<li>'+renderMarked(pt)+'</li>'; }).join("") : '') +
            '</ul></div>';
        });
      }
      h += '</div>';
      host.innerHTML = h;

      host.querySelectorAll("[data-rscope]").forEach(function(b){
        b.addEventListener("click", function(){
          host.setAttribute("data-scope", b.getAttribute("data-rscope"));
          renderFocusedReviewView();
        });
      });
      var ps = document.getElementById("revPageSelect");
      if(ps) ps.addEventListener("change", function(){ host.setAttribute("data-page", ps.value); renderFocusedReviewView(); });
      host.querySelectorAll("[data-rev-page-lb]").forEach(function(b){
        b.addEventListener("click", function(){ openPageReviewLightbox(Number(b.getAttribute("data-rev-page-lb"))); });
      });
      host.querySelectorAll("[data-rev-lb]").forEach(function(b){
        b.addEventListener("click", function(){ openTopicReviewLightbox(b.getAttribute("data-rev-lb")); });
      });
      host.querySelectorAll("[data-rev-quiz]").forEach(function(b){
        b.addEventListener("click", function(){ openTopicQuizLightbox(b.getAttribute("data-rev-quiz")); });
      });
    }

    /* Question Bank View */
    function renderQbankView(){
      var host = document.getElementById("viewQbank");
      var fPage = host.getAttribute("data-fpage") || "all";
      var fLevel = host.getAttribute("data-flevel") || "all";
      var fStatus = host.getAttribute("data-fstatus") || "all";
      var shuffleOn = host.getAttribute("data-shuffle") === "1";

      var list = QBANK.filter(function(q){
        if(fPage !== "all" && String(q.page) !== fPage) return false;
        if(fLevel !== "all" && q.level !== fLevel) return false;
        var rec = state.answeredMcqs[q.id];
        if(fStatus === "unanswered" && rec) return false;
        if(fStatus === "wrong" && (!rec || rec.correct)) return false;
        return true;
      });
      if(shuffleOn){
        list = list.slice().sort(function(){ return Math.random() - 0.5; });
      }

      var totalAns = Object.keys(state.answeredMcqs).length;
      var totalCor = Object.keys(state.answeredMcqs).filter(function(k){ return state.answeredMcqs[k].correct; }).length;

      var h = '<div class="workspace-panel">' +
        '<div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; align-items:center;">' +
        '<div><h2 style="font-size:1.5rem; font-weight:800; color:var(--navy);">بنك الأسئلة الطبي الشامل</h2>' +
        '<p style="color:var(--text-secondary);">'+QBANK.length+' سؤال MCQ مترجم مع تحليل تفصيلي لكل خيار صح أو خطأ</p></div>' +
        '<div style="padding:10px 16px; border-radius:10px; background:var(--turquoise-bg); font-weight:800; color:var(--navy);">الإجمالي: <span class="tabular-nums" style="color:var(--turquoise);">'+totalCor+' / '+totalAns+'</span> صحيحة</div>' +
        '</div>' +
        '<div class="filter-grid">' +
        '<select id="qbPage" class="select-input"><option value="all">كل الصفحات (1 - '+PAGES.length+')</option>'+PAGES.map(function(p){ return '<option value="'+p.pageNumber+'" '+(fPage===String(p.pageNumber)?'selected':'')+'>صفحة '+p.pageNumber+'</option>'; }).join("")+'</select>' +
        '<select id="qbLevel" class="select-input"><option value="all">كل المستويات</option>'+Object.keys(LEVEL_AR).map(function(lv){ return '<option value="'+lv+'" '+(fLevel===lv?'selected':'')+'>'+LEVEL_AR[lv]+'</option>'; }).join("")+'</select>' +
        '<select id="qbStatus" class="select-input"><option value="all" '+(fStatus==="all"?"selected":"")+'>كل الأسئلة</option><option value="unanswered" '+(fStatus==="unanswered"?"selected":"")+'>غير المحلولة فقط</option><option value="wrong" '+(fStatus==="wrong"?"selected":"")+'>الأخطاء السابقة للمراجعة</option></select>' +
        '<button id="qbShuffleBtn" class="btn-secondary">'+(shuffleOn ? "خلط عشوائي مفعل" : "خلط عشوائي للأسئلة")+'</button>' +
        '</div><div id="qbQuestionsHost"></div></div>';

      host.innerHTML = h;
      renderQuizCardsInto(document.getElementById("qbQuestionsHost"), list, "البنك المصفى");

      document.getElementById("qbPage").addEventListener("change", function(e){ host.setAttribute("data-fpage", e.target.value); renderQbankView(); });
      document.getElementById("qbLevel").addEventListener("change", function(e){ host.setAttribute("data-flevel", e.target.value); renderQbankView(); });
      document.getElementById("qbStatus").addEventListener("change", function(e){ host.setAttribute("data-fstatus", e.target.value); renderQbankView(); });
      document.getElementById("qbShuffleBtn").addEventListener("click", function(){
        host.setAttribute("data-shuffle", shuffleOn ? "0" : "1"); renderQbankView();
      });
    }

    /* Smart Search */
    function openSearchLightbox(){
      var html = '<div class="search-input-wrap"><input id="smartSearchInput" class="text-input" type="search" placeholder="ابحث بالعربي أو الإنجليزي... مثل: Radicular / Dentigerous / OKC / Gorlin / Bohn / Marsupialization / Curette / 5-FU" autofocus /></div>' +
        '<div id="smartSearchResults" style="color:var(--text-muted); font-size:0.9rem;">اكتب أي مصطلح علمي أو رقم للبحث الفوري في كل صفحات المحاضرة الـ 12</div>';
      openLightbox("البحث الذكي في ملزمة الأكياس الحميدة للفم والفكين (Benign Cystic Lesions)", html);

      var inp = document.getElementById("smartSearchInput");
      var resBox = document.getElementById("smartSearchResults");
      inp.addEventListener("input", function(){
        var q = inp.value.trim().toLowerCase();
        if(!q){ resBox.innerHTML = 'اكتب أي كلمة مفتاحية للبحث السريع'; return; }
        var matches = [];
        PAGES.forEach(function(p){
          p.topics.forEach(function(t){
            var blob = (t.titleEn + " " + t.titleAr + " " + t.segments.map(function(s){ return stripHtml(s.enHtml)+" "+stripHtml(s.iqHtml); }).join(" ")).toLowerCase();
            if(blob.indexOf(q) !== -1) matches.push({ page: p.pageNumber, topic: t });
          });
        });
        if(!matches.length){ resBox.innerHTML = 'لا توجد نتائج مطابقة لهذا المصطلح'; return; }
        resBox.innerHTML = matches.map(function(m){
          return '<button type="button" class="search-result-item" data-sjump-page="'+m.page+'" data-sjump-topic="'+esc(m.topic.id)+'">' +
            '<div style="font-size:0.78rem; color:var(--turquoise); font-weight:800;">صفحة '+m.page+'</div>' +
            '<div class="ltr" style="font-weight:800; color:var(--navy);">'+esc(m.topic.titleEn)+'</div>' +
            '<div style="font-size:0.86rem; color:var(--text-secondary);">'+esc(m.topic.titleAr)+'</div></button>';
        }).join("");
        resBox.querySelectorAll("[data-sjump-page]").forEach(function(b){
          b.addEventListener("click", function(){
            var pn = Number(b.getAttribute("data-sjump-page"));
            var tid = b.getAttribute("data-sjump-topic");
            closeLightbox(); switchView("lecture"); goToPage(pn);
            setTimeout(function(){ var el = document.getElementById("topic-"+tid); if(el) el.scrollIntoView({ behavior:"smooth", block:"start" }); }, 150);
          });
        });
      });
    }

    function animateHeroCounters(){
      var qEl = document.getElementById("cntQuestions");
      if(qEl) qEl.setAttribute("data-counter", String(QBANK.length));
      document.querySelectorAll("[data-counter]").forEach(function(el){
        var target = Number(el.getAttribute("data-counter")) || 0;
        var cur = 0, step = Math.max(1, Math.ceil(target / 24));
        var timer = setInterval(function(){
          cur += step;
          if(cur >= target){ el.textContent = target; clearInterval(timer); }
          else el.textContent = cur;
        }, 22);
      });
    }

    function boot(){
      loadState();
      animateHeroCounters();
      updateGlobalProgressUI();

      document.getElementById("openDrawerBtn").addEventListener("click", openDrawer);
      document.getElementById("closeDrawerBtn").addEventListener("click", closeDrawer);
      document.getElementById("drawerBackdrop").addEventListener("click", closeDrawer);
      document.getElementById("openSearchBtn").addEventListener("click", openSearchLightbox);
      document.getElementById("themeToggleBtn").addEventListener("click", function(){
        applyTheme(state.theme === "dark" ? "light" : "dark"); saveState();
      });
      document.getElementById("lightboxCloseBtn").addEventListener("click", closeLightbox);
      document.getElementById("lightboxOverlay").addEventListener("click", function(e){ if(e.target === this) closeLightbox(); });
      document.addEventListener("keydown", function(e){ if(e.key === "Escape"){ closeLightbox(); closeDrawer(); } });

      document.querySelectorAll(".nav-tab").forEach(function(b){
        b.addEventListener("click", function(){ switchView(b.getAttribute("data-view")); });
      });
      document.querySelectorAll("[data-drawer-view]").forEach(function(b){
        b.addEventListener("click", function(){ closeDrawer(); switchView(b.getAttribute("data-drawer-view")); });
      });

      document.getElementById("prevPageBtn").addEventListener("click", function(){ goToPage(state.currentPage - 1); });
      document.getElementById("nextPageBtn").addEventListener("click", function(){ goToPage(state.currentPage + 1); });
      document.getElementById("resumeStudyBtn").addEventListener("click", function(){
        switchView("lecture");
        document.getElementById("lecturePageMount").scrollIntoView({ behavior:"smooth" });
      });
      document.getElementById("quickGoQbankBtn").addEventListener("click", function(){ switchView("qbank"); });

      switchView(state.currentView);
    }

    if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
    else boot();
  })();
  </script>
</body>
</html>