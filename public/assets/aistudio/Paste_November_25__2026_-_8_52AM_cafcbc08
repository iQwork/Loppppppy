    function disposeGroup(THREE, grp){
      while(grp.children.length){
        var ch = grp.children[0];
        grp.remove(ch);
        if(ch.traverse){
          ch.traverse(function(node){
            if(node.geometry && typeof node.geometry.dispose === "function"){
              try { node.geometry.dispose(); } catch(e){}
            }
            if(node.material){
              var mats = Array.isArray(node.material) ? node.material : [node.material];
              mats.forEach(function(m){
                if(!m) return;
                if(m.map && typeof m.map.dispose === "function"){ try { m.map.dispose(); } catch(e){} }
                if(m.emissiveMap && typeof m.emissiveMap.dispose === "function"){ try { m.emissiveMap.dispose(); } catch(e){} }
                if(m.alphaMap && typeof m.alphaMap.dispose === "function"){ try { m.alphaMap.dispose(); } catch(e){} }
                if(typeof m.dispose === "function"){ try { m.dispose(); } catch(e){} }
              });
            }
          });
        }
      }
    }

    /* High-contrast Software 3D Projection Fallback if WebGL unavailable */
    function render3DFallback(ctx, w, h, rotX, rotY, zoom, spec, scIdx, explode, cutaway, tick){
      ctx.clearRect(0, 0, w, h);
      var cx = w * 0.5, cy = h * 0.54;
      var sc = Math.min(w, h) * (1.28 / Math.max(2.6, zoom));
      var cosY = Math.cos(rotY), sinY = Math.sin(rotY);
      var cosX = Math.cos(rotX), sinX = Math.sin(rotX);

      function proj(x, y, z){
        var x1 = x * cosY - z * sinY;
        var z1 = x * sinY + z * cosY;
        var y2 = y * cosX - z1 * sinX;
        var z2 = y * sinX + z1 * cosX;
        var persp = 4.6 / Math.max(1.5, 4.6 - z2 * 0.4);
        return { x: cx + x1 * sc * persp, y: cy - y2 * sc * persp, z: z2 };
      }

      // Contoured rounded jaw arch + stylized tooth crown silhouettes
      var jawPts = [[-1.08, -0.05], [1.08, -0.05], [1.02, -0.88], [-1.02, -0.88]].map(function(pt){
        return proj(pt[0], pt[1], 0);
      });
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(jawPts[0].x, jawPts[0].y);
      for(var i = 1; i < jawPts.length; i++) ctx.lineTo(jawPts[i].x, jawPts[i].y);
      ctx.closePath();
      ctx.fillStyle = cutaway ? "rgba(241,230,207,0.08)" : "rgba(241,230,207,0.18)";
      ctx.fill();
      ctx.strokeStyle = "rgba(241,230,207,0.42)";
      ctx.lineWidth = 2;
      ctx.stroke();

      // Tooth crowns along alveolar ridge
      [-0.68, -0.22, 0.24, 0.70].forEach(function(tx){
        var cTop = proj(tx, 0.36, 0);
        var cBot = proj(tx, -0.04, 0);
        ctx.fillStyle = "rgba(248,250,252,0.22)";
        ctx.strokeStyle = "rgba(248,250,252,0.45)";
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.roundRect ? ctx.roundRect(cTop.x - 10, cTop.y - 10, 20, Math.max(18, cBot.y - cTop.y + 8), 6) : ctx.rect(cTop.x - 10, cTop.y - 10, 20, 22);
        ctx.fill();
        ctx.stroke();
      });

      // Anatomical focal spheres for parts
      (spec.parts || []).forEach(function(pt, idx){
        var p3 = pt.getPos ? pt.getPos(tick, { scIdx: scIdx }) : pt.pos;
        if(!p3) return;
        var spread = explode ? 1.18 : 1.0;
        var pr = proj(p3[0] * spread, p3[1] * spread, p3[2] * spread);
        var cols = ["#14B8A6", "#F59E0B", "#38BDF8", "#F43F5E"];
        var col = cols[idx % cols.length];
        var grad = ctx.createRadialGradient(pr.x - 5, pr.y - 5, 3, pr.x, pr.y, 20);
        grad.addColorStop(0, "#FFFFFF");
        grad.addColorStop(0.35, col);
        grad.addColorStop(1, "rgba(15,23,42,0.5)");
        ctx.fillStyle = grad;
        ctx.globalAlpha = cutaway ? 0.72 : 0.92;
        ctx.beginPath(); ctx.arc(pr.x, pr.y, 19, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
        ctx.strokeStyle = "#F8FAFC"; ctx.lineWidth = 1.5;
        ctx.stroke();
      });
      ctx.restore();
      return proj;
    }

