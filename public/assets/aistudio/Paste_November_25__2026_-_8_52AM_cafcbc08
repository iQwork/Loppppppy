        var taper = 1 - Math.pow(u, 1.5);
        var r = u >= 0.999 ? 0.004 : Math.max(rBot, rTop * taper + rBot * (1 - taper));
        var N = frames.normals[i], B = frames.binormals[i];
        for(var j = 0; j <= radSegs; j++){
          var v = (j / radSegs) * Math.PI * 2;
          var cos = Math.cos(v), sin = Math.sin(v);
          n.set(cos * N.x + sin * B.x, cos * N.y + sin * B.y, cos * N.z + sin * B.z).normalize();
          verts.push(p.x + r * n.x, p.y + r * n.y, p.z + r * n.z);
          norms.push(n.x, n.y, n.z);
        }
      }
      var row = radSegs + 1;
      for(var i2 = 0; i2 < segs; i2++){
        for(var j2 = 0; j2 < radSegs; j2++){
          var a = i2 * row + j2, b = (i2 + 1) * row + j2;
