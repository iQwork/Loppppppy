          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
          renderer.setSize(viewW, viewH);
          if(THREE.ACESFilmicToneMapping !== undefined){
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.08;
          }
          hostEl.appendChild(renderer.domElement);

          scene = new THREE.Scene();
          camera = new THREE.PerspectiveCamera(42, viewW / viewH, 0.1, 60);
          camera.position.set(0, 0.22, st.zoom);

          var amb = new THREE.AmbientLight(0xffffff, 0.62);
          var hemi = new THREE.HemisphereLight(0xf8fafc, 0x1e293b, 0.55);
          var dir1 = new THREE.DirectionalLight(0xf8fafc, 0.98);
          dir1.position.set(4, 6, 5);
          var dir2 = new THREE.DirectionalLight(0x38bdf8, 0.52);
          dir2.position.set(-5, -2, -4);
          scene.add(amb, hemi, dir1, dir2);

          worldGrp = new THREE.Group();
          scene.add(worldGrp);

          raycaster = new THREE.Raycaster();
          pointerVec = new THREE.Vector2();
          useWebGL = true;
        } catch(e){
          useWebGL = false;
          if(renderer){ try { renderer.dispose(); } catch(err){} renderer = null; }
          hostEl.innerHTML = "";
        }
      }

      if(!useWebGL){
        fallbackCanvas = document.createElement("canvas");
        fallbackCanvas.style.cssText = "width:100%; height:100%; display:block;";
        hostEl.appendChild(fallbackCanvas);
        fallbackCtx = fallbackCanvas.getContext("2d");
        if(hudLtr) hudLtr.textContent = "3D Projection Studio · " + simId;
      }

      function rebuild3D(){
        if(!useWebGL || !worldGrp || !THREE) return;
        worldGrp.userData.animHook = null;
        disposeGroup(THREE, worldGrp);
        try {
          spec.build3D(THREE, worldGrp, st);
          applyPartHighlight(worldGrp, st.activePart);
        } catch(e){}
        needsRender = true;
        ensureLoop();
      }
      rebuild3D();

      stage.querySelectorAll("[data-sc-idx]").forEach(function(btn){
        btn.addEventListener("click", function(){
          var idx = Number(btn.getAttribute("data-sc-idx"));
          st.scIdx = idx;
          stage.querySelectorAll("[data-sc-idx]").forEach(function(b){ b.classList.toggle("active", b === btn); });
          var sc = spec.scenarios[idx];
          if(sc){
            guideEl.innerHTML = buildGuideHtml(sc);
            if(sc.activePart){
              st.activePart = sc.activePart;
              var part = (spec.parts || []).find(function(p){ return p.key === sc.activePart; });
              if(part && inspCardEl) inspCardEl.innerHTML = renderInspectorCard(part);
              stage.querySelectorAll(".sim-part-chip").forEach(function(c){
                c.classList.toggle("selected", c.getAttribute("data-part-key") === sc.activePart);
              });
              syncPinStyles(sc.activePart);
            }
          }
          rebuild3D();
        });
      });

      stage.querySelectorAll("[data-3d-act]").forEach(function(btn){
        btn.addEventListener("click", function(){
          var act = btn.getAttribute("data-3d-act");
          if(act === "explode"){
            st.explode = !st.explode;
            btn.classList.toggle("active", st.explode);
            rebuild3D();
          } else if(act === "cutaway"){
            st.cutaway = !st.cutaway;
            btn.classList.toggle("active", st.cutaway);
            rebuild3D();
          } else if(act === "zoomin"){
            st.zoom = Math.max(2.7, st.zoom - 0.55);
            needsRender = true; ensureLoop();
          } else if(act === "zoomout"){
            st.zoom = Math.min(8.6, st.zoom + 0.55);
            needsRender = true; ensureLoop();
          } else if(act === "autorot"){
            st.autoRotate = !st.autoRotate;
            btn.classList.toggle("active", st.autoRotate);
            btn.textContent = st.autoRotate ? "دوران تلقائي" : "إيقاف الدوران";
            needsRender = true; ensureLoop();
          } else if(act === "reset"){
            st.rotX = 0.22; st.rotY = 0.36; st.zoom = 5.4;
            st.explode = false; st.cutaway = true; st.autoRotate = true;
            var expB = stage.querySelector('[data-3d-act="explode"]'); if(expB) expB.classList.remove("active");
            var cutB = stage.querySelector('[data-3d-act="cutaway"]'); if(cutB) cutB.classList.add("active");
            var rotB = stage.querySelector('[data-3d-act="autorot"]'); if(rotB){ rotB.classList.add("active"); rotB.textContent = "دوران تلقائي"; }
            rebuild3D();
          }
        });
      });

      var dragging = false, moved = false, lastX = 0, lastY = 0, downX = 0, downY = 0;

      function onPointerDown(e){
        if(e.target && e.target.closest && e.target.closest("[data-pin-key]")) return;
        dragging = true; moved = false;
        lastX = downX = e.clientX;
        lastY = downY = e.clientY;
        ensureLoop();
      }
      function onPointerMove(e){
        if(!dragging) return;
        var dx = e.clientX - lastX;
        var dy = e.clientY - lastY;
        if(Math.abs(e.clientX - downX) > 4 || Math.abs(e.clientY - downY) > 4) moved = true;
        st.rotY += dx * 0.011;
        st.rotX = Math.max(-1.15, Math.min(1.15, st.rotX + dy * 0.011));
        lastX = e.clientX;
        lastY = e.clientY;
        needsRender = true;
        ensureLoop();
      }
      function onPointerUp(e){
        if(!dragging) return;
        dragging = false;
        if(!moved && e.type !== "pointercancel" && useWebGL && raycaster && renderer && worldGrp && camera){
          var rect = renderer.domElement.getBoundingClientRect();
          if(e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom){
            pointerVec.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            pointerVec.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(pointerVec, camera);
            var hits = raycaster.intersectObjects(worldGrp.children, true);
            for(var i = 0; i < hits.length; i++){
              var obj = hits[i].object;
              while(obj && obj !== worldGrp){
                if(obj.userData && obj.userData.partKey){
                  selectPart(obj.userData.partKey);
                  return;
                }
                obj = obj.parent;
              }
            }
          }
        }
      }
      function onWheel(e){
        e.preventDefault();
        st.zoom = Math.max(2.7, Math.min(8.2, st.zoom + (e.deltaY > 0 ? 0.38 : -0.38)));
        needsRender = true;
        ensureLoop();
      }

      viewportEl.addEventListener("pointerdown", onPointerDown);
      viewportEl.addEventListener("wheel", onWheel, { passive: false });
      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("pointerup", onPointerUp);
      window.addEventListener("pointercancel", onPointerUp);

      function handleResize(){
        viewW = hostEl.clientWidth || 640;
        viewH = hostEl.clientHeight || 430;
        measurePinBoxes();
        if(useWebGL && renderer && camera){
          camera.aspect = viewW / viewH;
          camera.updateProjectionMatrix();
          renderer.setSize(viewW, viewH);
        } else if(fallbackCanvas){
          var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          fallbackCanvas.width = Math.round(viewW * dpr);
          fallbackCanvas.height = Math.round(viewH * dpr);
        }
        needsRender = true;
      }
      var resObs = null;
      if(typeof ResizeObserver !== "undefined"){
        resObs = new ResizeObserver(handleResize);
        resObs.observe(hostEl);
      }
      window.addEventListener("resize", handleResize);
      handleResize();

      var rafId = 0, alive = true, isOnScreen = true, tick = 0, lastNow = 0, pinsSettling = false;
      var tmpVec = THREE ? new THREE.Vector3() : null;

      function layoutPinsAndLeaders(){
        var n = pinState.length;
        if(!n) return;
        var minYTop = 46, padX = 10, padBot = 10;
        var cx = viewW * 0.5, cy = viewH * 0.54;
        var keepRx = viewW >= 480 ? Math.min(viewW * 0.24, 168) : Math.min(viewW * 0.16, 62);
        var keepRy = viewH >= 380 && viewW >= 480 ? Math.min(viewH * 0.23, 104) : (n >= 4 ? viewH * 0.16 : viewH * 0.20);

        function clampCoords(ps, useTarget){
          var hw = ps.pw * 0.5, hh = ps.ph * 0.5;
          if(useTarget){
            ps.tx = Math.max(hw + padX, Math.min(viewW - hw - padX, ps.tx));
            ps.ty = Math.max(minYTop + hh, Math.min(viewH - hh - padBot, ps.ty));
          } else {
            ps.bx = Math.max(hw + padX, Math.min(viewW - hw - padX, ps.bx));
            ps.by = Math.max(minYTop + hh, Math.min(viewH - hh - padBot, ps.by));
          }
        }

        // 1. Smoothly steer outward direction and compute target position outside central model
        for(var i = 0; i < n; i++){
          var ps = pinState[i];
          var hw = ps.pw * 0.5, hh = ps.ph * 0.5;
          var vx = ps.ax - cx, vy = ps.ay - cy;
          var vLen = Math.hypot(vx, vy);
          if(vLen >= 26){
            var nx = vx / vLen, ny = vy / vLen;
            ps.dirX = ps.dirX * 0.82 + nx * 0.18;
            ps.dirY = ps.dirY * 0.82 + ny * 0.18;
            var dLen = Math.hypot(ps.dirX, ps.dirY) || 1;
            ps.dirX /= dLen;
            ps.dirY /= dLen;
          }
          var reqX = keepRx + hw + 18;
          var reqY = keepRy + hh + 14;
          var radScale = 1.0 / Math.max(Math.abs(ps.dirX) / reqX, Math.abs(ps.dirY) / reqY, 0.001);
          var reach = Math.max(radScale, vLen + 24);
          ps.tx = cx + ps.dirX * reach;
          ps.ty = cy + ps.dirY * reach;
          clampCoords(ps, true);
        }

        // 2. Collision solver across stable index order (prevents per-frame order flipping)
        var maxIter = viewW < 480 ? 9 : 7;
        for(var iter = 0; iter < maxIter; iter++){
          for(var a = 0; a < n; a++){
            for(var b = a + 1; b < n; b++){
              var p1 = pinState[a], p2 = pinState[b];
              var reqX2 = (p1.pw + p2.pw) * 0.5 + 14;
              var reqY2 = (p1.ph + p2.ph) * 0.5 + 12;
              var dx = p2.tx - p1.tx;
              var dy = p2.ty - p1.ty;
              if(Math.abs(dx) < reqX2 && Math.abs(dy) < reqY2){
                var ovY = reqY2 - Math.abs(dy);
                var ovX = reqX2 - Math.abs(dx);
                if(ovY <= ovX * 0.9 || Math.abs(dx) < 42){
                  var sY = dy === 0 ? (a < b ? 1 : -1) : (dy > 0 ? 1 : -1);
                  p1.ty -= sY * ovY * 0.52;
                  p2.ty += sY * ovY * 0.52;
                } else {
                  var sX = dx === 0 ? (a < b ? 1 : -1) : (dx > 0 ? 1 : -1);
                  p1.tx -= sX * ovX * 0.52;
                  p2.tx += sX * ovX * 0.52;
                }
                clampCoords(p1, true);
                clampCoords(p2, true);
              }
            }
          }
          for(var r = 0; r < n; r++){
            var pr = pinState[r];
            var kx = keepRx + pr.pw * 0.5 + 10;
            var ky = keepRy + pr.ph * 0.5 + 8;
            var cdx = pr.tx - cx, cdy = pr.ty - cy;
            if(Math.abs(cdx) < kx && Math.abs(cdy) < ky){
              var ex = kx - Math.abs(cdx), ey = ky - Math.abs(cdy);
              if(ex < ey && kx + padX + pr.pw * 0.5 < viewW * 0.49){
                pr.tx += (cdx >= 0 ? 1 : -1) * ex * 0.72;
              } else {
                pr.ty += (cdy >= 0 ? 1 : -1) * ey * 0.72;
              }
              clampCoords(pr, true);
            }
          }
        }

        // 3. Temporally smooth position + update SVG leaders safely
        pinsSettling = false;
        for(var m2 = 0; m2 < n; m2++){
          var pm = pinState[m2];
          if(!pm.placed){
            pm.bx = pm.tx;
            pm.by = pm.ty;
            pm.placed = true;
          } else {
            var remX = pm.tx - pm.bx, remY = pm.ty - pm.by;
            if(Math.abs(remX) > 0.6 || Math.abs(remY) > 0.6) pinsSettling = true;
            pm.bx += remX * 0.28;
            pm.by += remY * 0.28;
          }
          clampCoords(pm, false);

          if(Math.abs(pm.bx - pm.lastX) > 0.3 || Math.abs(pm.by - pm.lastY) > 0.3){
            pm.el.style.transform = "translate3d(" + pm.bx.toFixed(1) + "px," + pm.by.toFixed(1) + "px,0) translate(-50%,-50%)";
            pm.lastX = pm.bx;
            pm.lastY = pm.by;
          }
          if(pm.op !== pm.lastOp){
            pm.el.style.opacity = pm.op;
            pm.lastOp = pm.op;
          }
          if(pm.lineEl){
            var ldx = pm.ax - pm.bx, ldy = pm.ay - pm.by;
            var ldist = Math.hypot(ldx, ldy);
            if(ldist < 14){
              pm.lineEl.style.opacity = "0";
            } else {
              var lux = ldx / ldist, luy = ldy / ldist;
              var edgeT = Math.min(
                Math.abs(lux) > 0.001 ? ((pm.pw * 0.5 + 4) / Math.abs(lux)) : 1e6,
                Math.abs(luy) > 0.001 ? ((pm.ph * 0.5 + 4) / Math.abs(luy)) : 1e6
              );
              var stopGap = 7;
              if(ldist <= edgeT + stopGap + 4){
                pm.lineEl.style.opacity = "0";
              } else {
                var sx = pm.bx + lux * edgeT;
                var sy = pm.by + luy * edgeT;
                var tipX = pm.ax - lux * stopGap;
                var tipY = pm.ay - luy * stopGap;
                pm.lineEl.setAttribute("x1", sx.toFixed(1));
                pm.lineEl.setAttribute("y1", sy.toFixed(1));
                pm.lineEl.setAttribute("x2", tipX.toFixed(1));
                pm.lineEl.setAttribute("y2", tipY.toFixed(1));
                pm.lineEl.style.opacity = "1";
              }
            }
          }
          if(pm.dotEl){
            pm.dotEl.setAttribute("cx", pm.ax.toFixed(1));
            pm.dotEl.setAttribute("cy", pm.ay.toFixed(1));
            pm.dotEl.style.opacity = "1";
          }
        }
      }

      function renderFrame(now){
        if(!alive) return;
        rafId = 0;
        if(!isOnScreen || document.hidden) return;

        var dt = lastNow ? Math.min(0.05, (now - lastNow) * 0.001) : 0.016;
        lastNow = now;
        tick += dt;

        var hasHook = !!(useWebGL && worldGrp && worldGrp.userData && worldGrp.userData.animHook);
        if(st.autoRotate && !dragging){
          st.rotY += dt * 0.32;
          needsRender = true;
        }
        if(hasHook || !useWebGL || pinsSettling) needsRender = true;

        if(needsRender){
          needsRender = false;
          if(useWebGL && renderer && scene && camera && worldGrp){
            if(hasHook){ try { worldGrp.userData.animHook(tick); } catch(e){} }
            camera.position.z = st.zoom;
            worldGrp.rotation.x = st.rotX;
            worldGrp.rotation.y = st.rotY;
            worldGrp.updateMatrixWorld(true);
            camera.updateMatrixWorld(true);
            renderer.render(scene, camera);

            for(var i = 0; i < pinState.length; i++){
              var ps = pinState[i];
              var p3 = ps.getPos ? ps.getPos(tick, st) : null;
              tmpVec.set(p3 ? p3[0] : ps.x, p3 ? p3[1] : ps.y, p3 ? p3[2] : ps.z);
              tmpVec.applyMatrix4(worldGrp.matrixWorld);
              tmpVec.project(camera);
              if(tmpVec.z > 1){
                tmpVec.x = -tmpVec.x;
                tmpVec.y = -tmpVec.y;
              }
              ps.ax = Math.max(8, Math.min(viewW - 8, (tmpVec.x * 0.5 + 0.5) * viewW));
              ps.ay = Math.max(40, Math.min(viewH - 8, (-tmpVec.y * 0.5 + 0.5) * viewH));
              ps.op = "1";
            }
            layoutPinsAndLeaders();
          } else if(fallbackCanvas && fallbackCtx){
            var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
            fallbackCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
            var projFn = render3DFallback(fallbackCtx, viewW, viewH, st.rotX, st.rotY, st.zoom, spec, st.scIdx, st.explode, st.cutaway, tick);
            if(projFn){
              for(var j = 0; j < pinState.length; j++){
                var pj = pinState[j];
                var pj3 = pj.getPos ? pj.getPos(tick, st) : null;
                var pt2 = projFn(pj3 ? pj3[0] : pj.x, pj3 ? pj3[1] : pj.y, pj3 ? pj3[2] : pj.z);
                pj.ax = Math.max(8, Math.min(viewW - 8, pt2.x));
                pj.ay = Math.max(40, Math.min(viewH - 8, pt2.y));
                pj.op = "1";
              }
              layoutPinsAndLeaders();
            }
          }
        }

        if((st.autoRotate || dragging || hasHook || !useWebGL || pinsSettling) && isOnScreen && !document.hidden){
          rafId = requestAnimationFrame(renderFrame);
        }
      }

      function ensureLoop(){
        if(!alive || !isOnScreen || document.hidden) return;
        if(!rafId){
          lastNow = 0;
          rafId = requestAnimationFrame(renderFrame);
        }
      }

      var fontMeasureTimer = setTimeout(function(){
        if(alive){
          measurePinBoxes();
          needsRender = true;
          ensureLoop();
        }
      }, 140);

      var intObs = null;
      if(typeof IntersectionObserver !== "undefined"){
        intObs = new IntersectionObserver(function(entries){
          isOnScreen = !!(entries[0] && entries[0].isIntersecting);
          if(isOnScreen){
            needsRender = true;
            ensureLoop();
          } else if(rafId){
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
        }, { threshold: 0.05 });
        intObs.observe(viewportEl);
      }

      function onVisChange(){
        if(document.hidden){
          if(rafId){ cancelAnimationFrame(rafId); rafId = 0; }
        } else if(isOnScreen){
          needsRender = true;
          ensureLoop();
        }
      }
      document.addEventListener("visibilitychange", onVisChange);
      ensureLoop();

      registerCleanup(function(){
        alive = false;
        clearTimeout(fontMeasureTimer);
        if(rafId) cancelAnimationFrame(rafId);
        if(intObs) intObs.disconnect();
        if(resObs) resObs.disconnect();
        document.removeEventListener("visibilitychange", onVisChange);
        viewportEl.removeEventListener("pointerdown", onPointerDown);
        viewportEl.removeEventListener("wheel", onWheel);
        window.removeEventListener("pointermove", onPointerMove);
        window.removeEventListener("pointerup", onPointerUp);
        window.removeEventListener("pointercancel", onPointerUp);
        window.removeEventListener("resize", handleResize);
        if(useWebGL && THREE && worldGrp){
          disposeGroup(THREE, worldGrp);
        }
        if(renderer){
          try { renderer.dispose(); } catch(e){}
          try { renderer.forceContextLoss(); } catch(e){}
          renderer = null;
        }
      });
    }

    window.VisualSimEngine = {
      cleanupAll: cleanupAll,
      mountTopicVisual: function(topic){
        if(!topic || !topic.id) return;
        var stage = document.getElementById("vis-" + topic.id);
        if(!stage) return;
        mount3DSim(stage, topic.simId);
      }
    };
  })();
  </script>


  <script>
  (function(){
    "use strict";

    var STORAGE_KEY = "dr_yaser_benign_cysts_v1";
    var IDB_NAME = "DrYaserBenignCystsDB";
    var PAGES = window.ACADEMY_PAGES || [];
    var PAGE_REVIEWS = window.PAGE_REVIEWS || {};
    var QBANK = window.MCQ_BANK || [];

    var state = {
      theme: "light",
      currentView: "lecture",
      currentPage: 1,
      completedPages: [],
      completedTopics: [],
      bookmarkedTopics: [],
      reviewCompletedTopics: [],
      reviewHardTopics: [],
      answeredMcqs: {},
      testHistory: []
    };

    function loadState(){
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if(raw){
          var parsed = JSON.parse(raw);
          if(parsed && typeof parsed === "object"){
            Object.keys(state).forEach(function(k){
              if(parsed[k] !== undefined) state[k] = parsed[k];
            });
          }
        }
      } catch(e){}
      if(state.currentPage < 1 || state.currentPage > PAGES.length) state.currentPage = 1;
      applyTheme(state.theme);
    }

    function saveState(){
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e){}
      saveToIdb(state);
      updateGlobalProgressUI();
    }

    function saveToIdb(payload){
      if(!window.indexedDB) return;
      try {
        var req = indexedDB.open(IDB_NAME, 1);
        req.onupgradeneeded = function(e){
          var db = e.target.result;
          if(!db.objectStoreNames.contains("academyState")) db.createObjectStore("academyState", { keyPath: "id" });
        };
        req.onsuccess = function(e){
          var db = e.target.result;
          var tx = db.transaction(["academyState"], "readwrite");
          tx.objectStore("academyState").put({ id: "main", data: payload, updatedAt: Date.now() });
        };
      } catch(e){}
    }

    function esc(str){
      return String(str || "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    }
    function renderMarked(str){
      return esc(str)
        .replace(/&lt;mark class=&quot;(hl-(?:def|func|cause|warn|class|diff|num|exam))&quot;(?: data-pair=&quot;([a-zA-Z0-9_-]+)&quot;)?&gt;/g, function(_, cls, pair){
          return pair ? '<mark class="'+cls+'" data-pair="'+pair+'">' : '<mark class="'+cls+'">';
        })
        .replace(/&lt;\/mark&gt;/g, '</mark>');
    }
    function stripHtml(html){
      var d = document.createElement("div"); d.innerHTML = html || ""; return (d.textContent || "").trim();
    }
    function showToast(msg){
      var el = document.getElementById("toastBanner");
      if(!el) return;
      el.textContent = msg; el.classList.add("show");
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(function(){ el.classList.remove("show"); }, 2600);
    }
    function applyTheme(t){
      state.theme = t === "dark" ? "dark" : "light";
      document.documentElement.classList.toggle("dark", state.theme === "dark");
    }

    /* Drawer */
    function openDrawer(){
      document.getElementById("sideDrawer").classList.add("open");
      document.getElementById("drawerBackdrop").classList.add("open");
    }
    function closeDrawer(){
      document.getElementById("sideDrawer").classList.remove("open");
      document.getElementById("drawerBackdrop").classList.remove("open");
    }

    function updateGlobalProgressUI(){
      var totalTopics = PAGES.reduce(function(acc, p){ return acc + p.topics.length; }, 0);
      var pct = totalTopics ? Math.round((state.completedTopics.length / totalTopics) * 100) : 0;
      var fill = document.getElementById("globalProgressFill");
      if(fill) fill.style.width = pct + "%";

      var resBtn = document.getElementById("resumeStudyBtn");
      if(resBtn){
        resBtn.textContent = state.currentPage > 1 ? ("استئناف من الصفحة " + state.currentPage) : "ابدأ من الصفحة 1";
      }

      var drawerGrid = document.getElementById("drawerPagesGrid");
      if(drawerGrid){
        drawerGrid.innerHTML = PAGES.map(function(p){
          var cls = "drawer-page-chip";
          if(p.pageNumber === state.currentPage) cls += " current";
          else if(state.completedPages.indexOf(p.pageNumber) !== -1) cls += " done";
          return '<button class="'+cls+'" data-jump-page="'+p.pageNumber+'">'+p.pageNumber+'</button>';
        }).join("");
        drawerGrid.querySelectorAll("[data-jump-page]").forEach(function(b){
          b.addEventListener("click", function(){
            var pn = Number(b.getAttribute("data-jump-page"));
            closeDrawer(); switchView("lecture"); goToPage(pn);
          });
        });
      }
    }

    /* View Switching */
    function switchView(view){
      if(["lecture","review","qbank"].indexOf(view) === -1) view = "lecture";
      state.currentView = view;
      saveState();

      document.querySelectorAll(".nav-tab").forEach(function(t){
        t.classList.toggle("active", t.getAttribute("data-view") === view);
      });
      document.querySelectorAll(".drawer-section-btn").forEach(function(t){
        t.classList.toggle("active", t.getAttribute("data-drawer-view") === view);
      });

      document.getElementById("viewLecture").classList.toggle("hidden", view !== "lecture");
      document.getElementById("viewReview").classList.toggle("hidden", view !== "review");
      document.getElementById("viewQbank").classList.toggle("hidden", view !== "qbank");

      if(view === "lecture") renderLecturePage(state.currentPage);
      if(view === "review") renderFocusedReviewView();
      if(view === "qbank") renderQbankView();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    /* Lightbox */
    function openLightbox(title, html){
      document.getElementById("lightboxTitle").textContent = title;
      document.getElementById("lightboxBody").innerHTML = html;
      document.getElementById("lightboxOverlay").classList.add("open");
      document.body.style.overflow = "hidden";
    }
    function closeLightbox(){
      document.getElementById("lightboxOverlay").classList.remove("open");
      document.getElementById("lightboxBody").innerHTML = "";
      document.body.style.overflow = "";
    }

    function findTopic(topicId){
      for(var i=0; i<PAGES.length; i++){
        for(var j=0; j<PAGES[i].topics.length; j++){
          if(PAGES[i].topics[j].id === topicId) return { page: PAGES[i], topic: PAGES[i].topics[j] };
        }
      }
      return null;
    }

    /* Topic Review Lightbox */
    function openTopicReviewLightbox(topicId){
      var res = findTopic(topicId); if(!res) return;
      var t = res.topic, rev = t.review || { focusPoints:[], terms:[], compare:null };
      var isRevDone = state.reviewCompletedTopics.indexOf(t.id) !== -1;
      var isHard = state.reviewHardTopics.indexOf(t.id) !== -1;

      var html = '<div style="margin-bottom:16px;"><div style="font-size:0.85rem; color:var(--turquoise); font-weight:800;">'+esc(t.indexLabel)+'</div>' +
        '<div class="ltr" style="font-size:1.15rem; font-weight:800; color:var(--navy);">'+esc(t.titleEn)+'</div>' +
        '<div style="color:var(--text-secondary); font-weight:700;">'+esc(t.titleAr)+'</div></div>';

      if(rev.simpleWay){
        html += '<div style="padding:14px 16px; border-radius:12px; background:var(--gold-bg); border:1px solid rgba(180,138,62,0.34); margin-bottom:16px;">' +
          '<div style="font-weight:800; color:var(--gold); margin-bottom:6px; font-size:0.95rem;">أبسط طريقة تفهمها:</div>' +
          '<div style="font-weight:600; color:var(--text-primary); line-height:1.75;">'+renderMarked(rev.simpleWay)+'</div></div>';
      }

      html += '<div style="padding:16px; border-radius:12px; background:var(--bg-canvas); border:1px solid var(--border-hairline); margin-bottom:16px;">' +
        '<div style="font-weight:800; color:var(--navy); margin-bottom:10px;">أبرز النقاط المركزة للامتحان:</div><ul style="padding-right:18px; display:flex; flex-direction:column; gap:8px;">';
      (rev.focusPoints || []).forEach(function(pt){ html += '<li>'+renderMarked(pt)+'</li>'; });
      html += '</ul></div>';

      if(rev.terms && rev.terms.length){
        html += '<div style="font-weight:800; color:var(--navy); margin-bottom:10px;">بطاقات استرجاع المصطلحات (اضغط لكشف الشرح):</div>' +
          '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:10px; margin-bottom:16px;">';
        rev.terms.forEach(function(term){
          html += '<div class="flashcard" onclick="this.querySelector(\'.fc-ans\').classList.toggle(\'hidden\')">' +
            '<div class="ltr" style="font-weight:800; color:var(--navy);">'+renderMarked(term.en)+'</div>' +
            '<div style="font-size:0.78rem; color:var(--turquoise); margin-top:4px;">اضغط هنا لإظهار المعنى</div>' +
            '<div class="fc-ans hidden" style="margin-top:8px; padding-top:8px; border-top:1px dashed var(--border-strong); font-size:0.9rem;">'+renderMarked(term.iq)+'</div></div>';
        });
        html += '</div>';
      }

      if(rev.compare){
        html += '<div style="padding:16px; border-radius:12px; background:var(--turquoise-bg); border:1px solid rgba(13,148,136,0.25); margin-bottom:16px;">' +
          '<div style="font-weight:800; color:var(--navy); margin-bottom:10px;">'+renderMarked(rev.compare.title)+'</div>' +
          '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px;">' +
          '<div style="background:var(--bg-surface); padding:12px; border-radius:8px;"><div style="font-weight:800; color:var(--turquoise);">'+renderMarked(rev.compare.aLabel)+'</div><div>'+renderMarked(rev.compare.aText)+'</div></div>' +
          '<div style="background:var(--bg-surface); padding:12px; border-radius:8px;"><div style="font-weight:800; color:var(--gold);">'+renderMarked(rev.compare.bLabel)+'</div><div>'+renderMarked(rev.compare.bText)+'</div></div>' +
          '</div></div>';
      }

      html += '<div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:space-between; padding-top:12px; border-top:1px solid var(--border-hairline);">' +
        '<button class="btn-primary" id="lbMarkRevDone">'+(isRevDone ? "تمت مراجعة هذا الموضوع" : "تثبيت إتمام المراجعة")+'</button>' +
        '<button class="btn-secondary" id="lbToggleHard">'+(isHard ? "محدد كموضوع يحتاج تكراراً" : "إضافة لقائمة التكرار الصعب")+'</button>' +
        '</div>';

      openLightbox("مراجعة الموضوع: " + t.titleAr, html);

      document.getElementById("lbMarkRevDone").addEventListener("click", function(){
        if(state.reviewCompletedTopics.indexOf(t.id) === -1) state.reviewCompletedTopics.push(t.id);
        saveState();
        this.textContent = "تمت مراجعة هذا الموضوع";
        showToast("تم حفظ تقدم مراجعة الموضوع");
      });
      document.getElementById("lbToggleHard").addEventListener("click", function(){
        var idx = state.reviewHardTopics.indexOf(t.id);
        if(idx === -1){ state.reviewHardTopics.push(t.id); this.textContent = "محدد كموضوع يحتاج تكراراً"; showToast("أضيف إلى قائمة التكرار"); }
        else { state.reviewHardTopics.splice(idx, 1); this.textContent = "إضافة لقائمة التكرار الصعب"; showToast("أزيل من قائمة التكرار"); }
        saveState();
      });
